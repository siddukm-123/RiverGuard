# Safe placeholders only. Real values go in Railway (backend) / Vercel (frontend) settings, never in Git.
# ---- Already used by your current deployment (unchanged) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY
FLASK_SECRET_KEY=generate-a-long-random-string
FLASK_DEBUG=false
ENABLE_SCHEDULER=true
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_JSON=
CORS_ORIGIN=https://your-app.vercel.app
UPLOAD_DIR=/app/data/uploads
EVIDENCE_DIR=/app/data/evidence
# ---- NEW and all OPTIONAL (defaults shown) ----
# RIVERGUARD_API_KEY=            # if set, uploads/scans/add/delete require header X-API-Key (UI prompts once)
# SAT_BASELINE_DAYS=30           # 'before' scene target = 'after' scene - N days
# SAT_MIN_SEPARATION_DAYS=10     # reject scene pairs closer than this
# SAT_MIN_VALID_FRACTION=0.6     # min cloud-free pixel share inside the area of interest
# SAT_RAIN_CONFOUNDER_MM=50
# NOTIFY_COOLDOWN_HOURS=24
# HIGH_REQUIRES_CORROBORATION=true
# FOLD_VEHICLES_AS_TRUCK=false   # legacy behaviour = true (cars/buses counted as trucks)
# VIDEO_MAX_SECONDS=600
# LOWLIGHT_DARK_LUMA_THRESHOLD=70
# CUSTOM_JCB_MODEL_PATH=models/best.pt
